---
import Base from '../layouts/Base.astro';
import DiamondStrip from './DiamondStrip.astro';
import { t, type Lang } from '../i18n/ui';
import { site } from '../config';
import { Image } from 'astro:assets';
import { team } from '../data/team';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const a = c.about;
const memberLink =
  'inline-flex min-h-10 items-center gap-2 rounded-full bg-cream px-3.5 text-sm font-semibold no-underline hover:bg-navy hover:text-cream';

---
<Base lang={lang} page="about" title={c.meta.aboutTitle}>
  <section class="flex" aria-labelledby="about-title">
    <DiamondStrip id="dm-about" orientation="vertical" size={96} />
    <div class="mx-auto flex max-w-[1104px] min-w-0 flex-auto flex-col gap-8 px-8 pt-[clamp(64px,9vw,112px)] pb-24">
      <div class="rule-heading"><h1 id="about-title" class="text-[clamp(72px,12vw,160px)]! leading-[0.85]!">{a.heading}</h1></div>
      <p class="m-0 text-[22px] font-medium">{site.name}</p>
      <p class="m-0 max-w-[820px] font-serif text-[clamp(24px,3vw,38px)] leading-[1.3] font-bold">{a.lead}</p>
    </div>
  </section>

  <section class="wrap flex flex-wrap gap-x-16 gap-y-8 pt-8 pb-24">
    <div class="flex flex-[1_1_300px] flex-col gap-3">
      <p class="eyebrow">{a.storyLabel}</p>
      <p class="m-0 font-serif text-[32px] leading-[1.15] font-extrabold">{a.storyTitle}</p>
    </div>
    <div class="flex-[999_1_520px] text-lg leading-[1.7] text-ink-soft">
      {a.story.map((para) => <p class="mt-0 mb-5">{para}</p>)}
    </div>
  </section>

  <section class="bg-terracotta text-cream" aria-labelledby="how-title">
    <div class="wrap flex flex-col gap-12 py-24">
      <h2 id="how-title" class="m-0 font-serif text-[clamp(44px,6vw,72px)] leading-none font-black tracking-[-0.02em]">{a.howTitle}</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-6">
        {a.how.map((h, i) => (
          <div class="flex flex-col gap-3 rounded-[20px] bg-terracotta-dark p-8">
            <span class="font-serif text-[40px] font-black text-mustard-light">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="m-0 text-[22px] font-bold">{h.title}</h3>
            <p class="m-0 leading-[1.6]">{h.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap py-28" aria-labelledby="team-title">
    <div class="rule-heading mb-12"><h2 id="team-title">{a.teamTitle}</h2></div>
    <!-- Phone: photo left, info right. From sm up: photo on top. -->
    <ul class="m-0 grid list-none grid-cols-1 gap-4 p-0 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
      {team.map((m) => (
        <li class="flex flex-row overflow-hidden rounded-[20px] border border-line bg-white sm:flex-col">
          <Image
            src={m.photo}
            alt={m.name}
            widths={[256, 360, 540, 720]}
            sizes="(max-width: 639px) 128px, (max-width: 1023px) 45vw, 360px"
            format="webp"
            quality={80}
            loading="lazy"
            class="block aspect-[1080/1350] h-auto w-32 shrink-0 self-start bg-sand object-cover sm:w-full"
          />
          <div class="flex min-w-0 flex-col justify-center gap-1 p-4 sm:justify-start sm:px-6 sm:pt-5 sm:pb-6">
            <h3 class="m-0 text-lg leading-snug font-bold sm:text-xl">{m.name}</h3>
            <p class="m-0 text-[15px] text-muted sm:text-base">{m.role[lang]}</p>
            <div class="mt-2 flex flex-wrap gap-2 sm:mt-3">
              <a href={m.linkedin} rel="noopener" aria-label={`${m.name} — LinkedIn`} class={memberLink}>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm7 0h3.8v1.6h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.2c0-1.24-.02-2.84-1.73-2.84-1.73 0-2 1.35-2 2.75V21h-4V9.5Z" /></svg>
                LinkedIn
              </a>
              {m.website && (
                <a href={m.website} rel="noopener" aria-label={`${m.name} — ${a.website}`} class={memberLink}>
                  <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z" /></svg>
                  {a.website}
                </a>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap">
    <div class="mb-28 flex flex-wrap items-center justify-between gap-6 rounded-3xl bg-mustard px-[clamp(28px,4vw,48px)] py-[clamp(32px,5vw,56px)]">
      <div class="flex-[1_1_480px]">
        <h2 class="mt-0 mb-2.5 font-serif text-[clamp(32px,5vw,56px)] leading-[1.05] font-black tracking-[-0.02em]">{a.ctaTitle}</h2>
        <p class="m-0 text-lg">{a.ctaBody}</p>
      </div>
      <a href={`mailto:${site.email}`} class="btn btn-dark">{a.ctaButton}</a>
    </div>
  </section>
</Base>
