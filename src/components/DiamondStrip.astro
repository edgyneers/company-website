---
// Woven diamond border from the Instagram feed. Vertical strips fill their parent's height.
interface Props {
  id: string;
  orientation?: 'vertical' | 'horizontal';
  size?: number;
}
const { id, orientation = 'horizontal', size = 40 } = Astro.props;
const s = size;
const vertical = orientation === 'vertical';
---
<svg
  aria-hidden="true"
  class:list={['block', vertical ? 'min-h-full self-stretch max-sm:hidden' : 'w-full']}
  style={vertical ? `width:${s}px;flex:0 0 ${s}px` : `height:${s}px`}
>
  <defs>
    <pattern id={id} width={s} height={s} patternUnits="userSpaceOnUse">
      <rect width={s} height={s} fill="#0E1424" />
      <path d={`M${s/2} ${s*0.07} L${s*0.93} ${s/2} L${s/2} ${s*0.93} L${s*0.07} ${s/2}Z`} fill="none" stroke="#A2513A" stroke-width={s*0.09} />
      <path d={`M${s/2} ${s*0.27} L${s*0.73} ${s/2} L${s/2} ${s*0.73} L${s*0.27} ${s/2}Z`} fill="none" stroke="#F3EFE6" stroke-width={s*0.045} />
      <rect x={s*0.43} y={s*0.43} width={s*0.14} height={s*0.14} fill="#DFA942" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
