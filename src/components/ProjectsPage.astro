---
import Base from '../layouts/Base.astro';
import DiamondStrip from './DiamondStrip.astro';
import YouTubeFacade from './YouTubeFacade.astro';
import GedoganIllo from './GedoganIllo.astro';
import { t, localePath, type Lang } from '../i18n/ui';
import { site } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const p = c.projects;
const ytUrl = `https://www.youtube.com/watch?v=${site.youtubeId}`;
---
<Base lang={lang} page="" title={c.meta.projectsTitle}>
  <!-- Film -->
  <section class="film" aria-labelledby="film-title">
    <DiamondStrip id="dm-film" orientation="vertical" size={56} />
    <div class="film-inner">
      <div class="film-top">
        <p class="eyebrow mustard">{p.filmEyebrow}</p>
        <p class="film-meta">{p.filmMeta}</p>
      </div>
      <YouTubeFacade videoId={site.youtubeId} label={p.filmPlay} lang={lang} />
      <div class="film-bottom">
        <h1 id="film-title" class="serif film-title">{p.filmTitle[0]}<br />{p.filmTitle[1]}</h1>
        <a href={ytUrl} class="btn btn-mustard" rel="noopener">{p.watchYoutube}</a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="wrap intro">
    <p class="eyebrow intro-label">{p.introLabel}</p>
    <p class="serif intro-text">{p.intro}</p>
  </section>

  <!-- Projects -->
  <section class="wrap" aria-labelledby="projects-title">
    <div class="rule-heading heading-pad"><h2 id="projects-title">{p.heading}</h2></div>

    <article class="project">
      <div class="project-art"><GedoganIllo label={p.illoAlt} /></div>
      <div class="project-body">
        <div class="chips">
          <span class="chip chip-dark">{p.featured}</span>
          <span class="chip">{p.type}</span>
          <span class="chip">2026</span>
        </div>
        <h3 class="serif project-title">Martonun</h3>
        <p class="eyebrow">{p.meaning}</p>
        <p class="project-desc">{p.body}</p>
        <ol class="steps">
          {p.steps.map((s, i) => (
            <li><span class="serif step-n">{String(i + 1).padStart(2, '0')}</span><span class="step-t">{s}</span></li>
          ))}
        </ol>
        <dl class="facts">
          <div><dt>{p.builtWith}</dt><dd>{p.builtWithValue}</dd></div>
          <div><dt>{p.shownAt}</dt><dd>{p.shownAtValue}</dd></div>
        </dl>
        <div class="actions">
          <a href={ytUrl} class="btn btn-dark" rel="noopener">{p.watchFilm}</a>
          <a href="#" class="btn btn-outline">{p.caseStudy}</a>
        </div>
      </div>
    </article>

    <article class="next">
      <div class="next-text">
        <p class="eyebrow mustard-light">{p.nextEyebrow}</p>
        <h3 class="serif next-title">{p.nextTitle}</h3>
      </div>
      <a href={localePath(lang, 'about')} class="btn btn-cream">{p.meet}</a>
    </article>
  </section>
</Base>

<style>
  .film { display: flex; background: var(--navy); color: var(--cream); }
  .film-inner { flex: 1 1 auto; min-width: 0; max-width: 1144px; margin: 0 auto; padding: 56px 32px 64px; display: flex; flex-direction: column; gap: 24px; }
  .film-top, .film-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; }
  .film-top { align-items: baseline; }
  .film-bottom { align-items: flex-end; }
  .mustard { color: var(--mustard); }
  .mustard-light { color: var(--mustard-light); }
  .film-meta { margin: 0; color: #c9c4ba; font-size: 15px; }
  .film-title { margin: 0; font-weight: 900; font-size: clamp(40px, 6vw, 72px); line-height: 1; letter-spacing: -.02em; }

  .intro { display: flex; flex-wrap: wrap; gap: 32px 64px; padding-block: 96px 48px; }
  .intro-label { flex: 1 1 240px; }
  .intro-text { flex: 999 1 560px; margin: 0; font-weight: 700; font-size: clamp(24px, 3vw, 38px); line-height: 1.3; }

  .heading-pad { padding: 48px 0 48px; }

  .project { display: flex; flex-wrap: wrap; border-radius: 24px; overflow: hidden; background: #fff; border: 1px solid var(--line); }
  .project-art { flex: 1 1 380px; min-height: 480px; background: var(--mustard); display: flex; align-items: flex-end; justify-content: center; padding-top: 48px; }
  .project-body { flex: 999 1 480px; min-width: 0; padding: clamp(28px, 4vw, 48px); display: flex; flex-direction: column; gap: 24px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .project-title { margin: 0; font-weight: 900; font-size: clamp(56px, 7vw, 96px); line-height: .95; letter-spacing: -.02em; }
  .project-desc { margin: 0; font-size: 18px; line-height: 1.65; color: var(--ink-soft); }
  .steps { list-style: none; margin: 8px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; }
  .steps li { padding: 18px; border-radius: 16px; background: var(--cream); display: flex; flex-direction: column; gap: 6px; }
  .step-n { font-weight: 900; font-size: 28px; color: var(--terracotta); }
  .step-t { font-weight: 700; }
  .facts { margin: 8px 0 0; padding-top: 24px; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px 24px; }
  .facts dt { font-size: 13px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .facts dd { margin: 4px 0 0; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }

  .next { margin: 32px 0 112px; border-radius: 24px; background: var(--terracotta); color: var(--cream); padding: clamp(28px, 4vw, 48px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; }
  .next-text { flex: 1 1 420px; display: flex; flex-direction: column; gap: 8px; }
  .next-title { margin: 0; font-weight: 800; font-size: clamp(28px, 4vw, 40px); line-height: 1.1; }
</style>
