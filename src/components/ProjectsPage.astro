---
import Base from '../layouts/Base.astro';
import DiamondStrip from './DiamondStrip.astro';
import YouTubeFacade from './YouTubeFacade.astro';
import GedoganIllo from './GedoganIllo.astro';
import { t, localePath, type Lang } from '../i18n/ui';
import { site } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const p = c.works;
const ytUrl = `https://www.youtube.com/watch?v=${site.youtubeId}`;
---
<Base lang={lang} page="" title={c.meta.worksTitle}>
  <!-- Film -->
  <section class="flex bg-navy text-cream" aria-labelledby="film-title">
    <DiamondStrip id="dm-film" orientation="vertical" size={56} />
    <div class="mx-auto flex max-w-[1144px] min-w-0 flex-auto flex-col gap-6 px-8 pt-14 pb-16">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <p class="eyebrow text-mustard">{p.filmEyebrow}</p>
        <p class="m-0 text-[15px] text-stone">{p.filmMeta}</p>
      </div>
      <YouTubeFacade videoId={site.youtubeId} label={p.filmPlay} lang={lang} />
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h1 id="film-title" class="m-0 font-serif text-[clamp(40px,6vw,72px)] leading-none font-black tracking-[-0.02em]">{p.filmTitle[0]}<br />{p.filmTitle[1]}</h1>
        <a href={ytUrl} class="btn btn-mustard" rel="noopener">{p.watchYoutube}</a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="wrap flex flex-wrap gap-x-16 gap-y-8 pt-24 pb-12">
    <p class="eyebrow flex-[1_1_240px]">{p.introLabel}</p>
    <p class="m-0 flex-[999_1_560px] font-serif text-[clamp(24px,3vw,38px)] leading-[1.3] font-bold">{p.intro}</p>
  </section>

  <!-- Works -->
  <section class="wrap" aria-labelledby="works-title">
    <div class="rule-heading py-12"><h2 id="works-title">{p.heading}</h2></div>

    <article class="flex flex-wrap overflow-hidden rounded-3xl border border-line bg-white">
      <div class="flex min-h-[480px] flex-[1_1_380px] items-end justify-center bg-mustard pt-12">
        <GedoganIllo label={p.illoAlt} />
      </div>
      <div class="flex min-w-0 flex-[999_1_480px] flex-col gap-6 p-[clamp(28px,4vw,48px)]">
        <div class="flex flex-wrap gap-2">
          <span class="chip bg-navy text-cream">{p.featured}</span>
          <span class="chip">{p.type}</span>
          <span class="chip">2026</span>
        </div>
        <h3 class="m-0 font-serif text-[clamp(56px,7vw,96px)] leading-[0.95] font-black tracking-[-0.02em]">Martonun</h3>
        <p class="eyebrow">{p.meaning}</p>
        <p class="m-0 text-lg leading-[1.65] text-ink-soft">{p.body}</p>
        <ol class="mt-2 grid list-none grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-4 p-0">
          {p.steps.map((s, i) => (
            <li class="flex flex-col gap-1.5 rounded-2xl bg-cream p-[18px]">
              <span class="font-serif text-[28px] font-black text-terracotta">{String(i + 1).padStart(2, '0')}</span>
              <span class="font-bold">{s}</span>
            </li>
          ))}
        </ol>
        <dl class="mt-2 grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-x-6 gap-y-4 border-t border-line pt-6">
          <div>
            <dt class="text-[13px] font-bold tracking-[0.08em] text-muted uppercase">{p.builtWith}</dt>
            <dd class="mt-1 ml-0">{p.builtWithValue}</dd>
          </div>
          <div>
            <dt class="text-[13px] font-bold tracking-[0.08em] text-muted uppercase">{p.shownAt}</dt>
            <dd class="mt-1 ml-0">{p.shownAtValue}</dd>
          </div>
        </dl>
        <div class="mt-2 flex flex-wrap gap-3">
          <a href={ytUrl} class="btn btn-dark" rel="noopener">{p.watchFilm}</a>
          <a href="#" class="btn btn-outline">{p.caseStudy}</a>
        </div>
      </div>
    </article>

    <article class="mt-8 mb-28 flex flex-wrap items-center justify-between gap-6 rounded-3xl bg-terracotta p-[clamp(28px,4vw,48px)] text-cream">
      <div class="flex flex-[1_1_420px] flex-col gap-2">
        <p class="eyebrow text-mustard-light">{p.nextEyebrow}</p>
        <h3 class="m-0 font-serif text-[clamp(28px,4vw,40px)] leading-[1.1] font-extrabold">{p.nextTitle}</h3>
      </div>
      <a href={localePath(lang, 'about')} class="btn btn-cream">{p.meet}</a>
    </article>
  </section>
</Base>
