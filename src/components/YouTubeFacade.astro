---
// Lightweight YouTube player: shows our own poster and only loads the YouTube
// iframe (≈1 MB of JS) once the visitor presses play.
import Tagline from './Tagline.astro';
import Logo from './Logo.astro';
import Skyline from './Skyline.astro';
import type { Lang } from '../i18n/ui';

interface Props { videoId: string; label: string; lang: Lang }
const { videoId, label, lang } = Astro.props;
---
<div class="yt relative aspect-video w-full overflow-hidden rounded-[20px] bg-terracotta [&_iframe]:absolute [&_iframe]:inset-0 [&_iframe]:size-full [&_iframe]:border-0" data-video-id={videoId}>
  <button type="button" class="group absolute inset-0 block cursor-pointer appearance-none border-0 bg-transparent p-0 focus-visible:rounded-[20px] focus-visible:-outline-offset-6" aria-label={label}>
    <!-- Skyline sits on the bottom edge; the sun runs past it and is clipped by the frame. -->
    <Skyline class="absolute bottom-0 left-1/2 h-auto w-[62%] -translate-x-1/2" />
    <span class="absolute inset-x-0 top-0 flex h-[58%] flex-col items-center justify-center gap-5 px-4 text-center text-cream">
      <Logo height={72} class="h-11 w-auto text-cream sm:h-[72px]" />
      <span class="flex size-16 items-center justify-center rounded-full bg-cream shadow-[0_10px_30px_rgba(14,20,36,.35)] transition-transform duration-200 group-hover:scale-105 sm:size-24">
        <svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24"><path d="M7 4.5 L20 12 L7 19.5Z" fill="#A2513A" /></svg>
      </span>
      <Tagline lang={lang} />
    </span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    const btn = el.querySelector('button');
    btn?.addEventListener('click', () => {
      const id = el.dataset.videoId;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = btn.getAttribute('aria-label') ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      iframe.focus();
    }, { once: true });
  });
</script>
