---
// Lightweight YouTube player: shows our own poster and only loads the YouTube
// iframe (≈1 MB of JS) once the visitor presses play.
import Tagline from './Tagline.astro';
import Logo from './Logo.astro';
import Skyline from './Skyline.astro';
import type { Lang } from '../i18n/ui';

interface Props { videoId: string; label: string; lang: Lang }
const { videoId, label, lang } = Astro.props;
---
<div class="yt" data-video-id={videoId}>
  <button type="button" class="yt-poster" aria-label={label}>
    <Skyline class="yt-art" />
    <span class="yt-center">
      <Logo height={72} class="yt-logo" />
      <span class="yt-play">
        <svg aria-hidden="true" width="34" height="34" viewBox="0 0 24 24"><path d="M7 4.5 L20 12 L7 19.5Z" fill="#A2513A" /></svg>
      </span>
      <Tagline lang={lang} />
    </span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.yt').forEach((el) => {
    const btn = el.querySelector('button');
    btn?.addEventListener('click', () => {
      const id = el.dataset.videoId;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = btn.getAttribute('aria-label') ?? 'YouTube video';
      iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
      iframe.focus();
    }, { once: true });
  });
</script>

<style>
  .yt { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 20px; overflow: hidden; background: var(--terracotta); }
  .yt :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .yt-poster { all: unset; cursor: pointer; position: absolute; inset: 0; display: block; }
  .yt-poster:focus-visible { outline: 3px solid var(--mustard); outline-offset: -6px; border-radius: 20px; }
  /* Skyline sits on the bottom edge; the sun runs past it and is clipped by the frame. */
  .yt-poster :global(.yt-art) { position: absolute; left: 50%; bottom: 0; width: 62%; height: auto; transform: translateX(-50%); }
  .yt-center { position: absolute; inset: 0 0 auto; height: 58%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px; padding: 0 16px; text-align: center; color: var(--cream); }
  .yt-play { width: 96px; height: 96px; border-radius: 50%; background: var(--cream); display: flex; align-items: center; justify-content: center; box-shadow: 0 10px 30px rgba(14,20,36,.35); transition: transform .2s; }
  .yt-poster:hover .yt-play { transform: scale(1.06); }
  .yt-center :global(.yt-logo) { color: var(--cream); }
  @media (max-width: 640px) {
    .yt-play { width: 64px; height: 64px; }
    .yt-center :global(.yt-logo) { height: 44px; width: auto; }
  }
</style>
