---
import '../styles/global.css';
import DiamondStrip from '../components/DiamondStrip.astro';
import Logo from '../components/Logo.astro';
import { languages, localePath, t, type Lang } from '../i18n/ui';
import { site } from '../config';

interface Props {
  lang: Lang;
  page: '' | 'about';
  title: string;
}
const { lang, page, title } = Astro.props;
const c = t(lang);
const langs = Object.keys(languages) as Lang[];
const navLink =
  'flex min-h-12 items-center rounded-full border-[1.5px] px-[18px] text-base font-semibold no-underline aria-[current=page]:bg-navy aria-[current=page]:text-cream md:inline-flex md:min-h-11 md:text-[15px]';
const canonical = new URL(localePath(lang, page), Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={c.meta.description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={new URL(localePath(l, page), Astro.site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', page), Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0E1424" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site)} />
  </head>
  <body>
    <header class="group sticky top-0 z-50 border-b border-rule bg-cream" data-site-header>
      <nav aria-label={c.nav.main} class="wrap flex flex-wrap items-center justify-between gap-x-4 py-3 md:py-5">
        <a href={localePath(lang, '')} class="flex items-center gap-3 text-navy no-underline">
          <Logo height={30} class="h-6 w-auto text-navy md:h-[30px]" />
          <span class="font-serif text-lg font-extrabold tracking-[-0.01em] md:text-[22px]">{site.name}</span>
        </a>

        <!-- Burger: mobile only -->
        <button
          type="button"
          class="inline-flex size-11 items-center justify-center rounded-full text-navy hover:bg-sand md:hidden"
          aria-controls="site-menu"
          aria-expanded="false"
          aria-label={c.nav.menu}
          data-menu-toggle
        >
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="group-data-open:hidden"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden group-data-open:block"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>

        <!-- Links: dropdown panel on mobile, inline row from md up -->
        <div
          id="site-menu"
          class="hidden w-full flex-col gap-1 pt-3 pb-4 group-data-open:flex md:flex md:w-auto md:flex-row md:items-center md:gap-2 md:p-0"
        >
          <a href={localePath(lang, '')} class={`${navLink} border-transparent`} aria-current={page === '' ? 'page' : undefined}>{c.nav.works}</a>
          <a href={localePath(lang, 'about')} class={`${navLink} border-transparent`} aria-current={page === 'about' ? 'page' : undefined}>{c.nav.about}</a>
          <a href={site.instagram} class={`${navLink} border-transparent md:border-navy`} rel="noopener">Instagram ↗</a>
          <div class="mt-3 flex self-start rounded-full bg-sand p-1 md:mt-0 md:ml-2" role="group" aria-label={c.nav.language}>
            {langs.map((l) => (
              <a
                href={localePath(l, page)}
                hreflang={l}
                lang={l}
                aria-current={l === lang ? 'true' : undefined}
                class="inline-flex min-h-10 min-w-11 items-center justify-center rounded-full px-3.5 text-sm font-bold no-underline aria-[current=true]:bg-terracotta aria-[current=true]:text-cream"
              >{languages[l]}</a>
            ))}
          </div>
        </div>
      </nav>
    </header>

    <script>
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const setOpen = (open: boolean) => {
        header?.toggleAttribute('data-open', open);
        toggle?.setAttribute('aria-expanded', String(open));
      };
      toggle?.addEventListener('click', () => setOpen(!header?.hasAttribute('data-open')));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header?.hasAttribute('data-open')) { setOpen(false); toggle?.focus(); }
      });
      // Close when resizing up to the desktop layout.
      matchMedia('(min-width: 48rem)').addEventListener('change', (e) => e.matches && setOpen(false));
    </script>

    <main>
      <slot />
    </main>

    <footer class="bg-navy text-cream">
      <DiamondStrip id="dm-footer" />
      <div class="wrap flex flex-wrap justify-between gap-8 py-14">
        <div class="flex flex-col gap-2.5">
          <Logo height={44} />
          <span class="font-serif text-[28px] font-extrabold">{site.name}</span>
          <span class="text-stone">{c.tagline.a} {c.tagline.b} {c.tagline.c} {c.tagline.d}</span>
        </div>
        <div class="flex flex-wrap items-center gap-x-7 gap-y-2 text-[15px] [&_a]:text-cream [&_a:hover]:text-mustard-light">
          <a href={localePath(lang, '')}>{c.nav.works}</a>
          <a href={localePath(lang, 'about')}>{c.nav.about}</a>
          <a href={site.instagram} rel="noopener">{site.instagramHandle}</a>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
